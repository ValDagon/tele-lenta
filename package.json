{
  "name": "tele-lenta",
  "private": true,
  "version": "0.1.0",
  "description": "Tele-Lenta: one feed for classifieds and jobs from public Telegram chats",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValDagon/tele-lenta.git"
  },
  "bugs": {
    "url": "https://github.com/ValDagon/tele-lenta/issues"
  },
  "homepage": "https://github.com/ValDagon/tele-lenta#readme",
  "workspaces": [
    "vps"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build --workspaces --if-present",
    "preview": "vite preview",
    "deploy": "npm run build && npx tgcloud push",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run && npm run test --workspaces --if-present",
    "test:tgcloud": "node --test tgcloud/test/*.test.js",
    "migrate": "npm -w vps run migrate"
  },
  "dependencies": {
    "preact": "^11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
