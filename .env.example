# Copy to .env (never commit it) or export these from the service manager.
# The loader validates them at boot; empty values are rejected.

# API bind address. Keep it on loopback: Caddy is the only public listener.
TL_HOST=127.0.0.1
TL_PORT=8787

# SQLite file. The migration command creates the parent directory.
TL_DATABASE_PATH=./data/tele-lenta.db

# fatal | error | warn | info | debug | trace | silent
TL_LOG_LEVEL=info

# Shared secret between the Serverless BFF and this API. At least 32 characters.
# Required by the API process; the collector tick and migrate command do not need it.
TL_SHARED_SECRET=

# Owner Telegram id for the VPS admin CLI (allow/deny/list/forget). Optional.
TL_OWNER_TELEGRAM_ID=

# Bot API credentials for the Дайджест. Optional: without either variable the
# minute tick still ingests, but no digest message is sent. The username is
# stored without the leading `@` and must be 4-32 letters, digits, or
# underscores; it builds the Mini App card links.
TL_BOT_TOKEN=
TL_BOT_USERNAME=

# Timeout for the card detail's one live not-found probe (1..30000 ms).
# The probe runs while the reader waits for the card, so keep it short.
TL_DETAIL_PROBE_TIMEOUT_MS=2000

# Per-source request budget for one manual backfill (1..50000). Default 5000.
# A seven-day group backfill can need thousands of embed probes, so the default
# is a few hours at one request per second per source.
TL_BACKFILL_BUDGET=5000
