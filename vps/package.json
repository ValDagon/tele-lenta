{
  "name": "@tele-lenta/vps",
  "private": true,
  "version": "0.1.0",
  "description": "Tele-Lenta VPS collector: SQLite store, API, and worker",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/cli/migrate.ts",
    "tick": "tsx src/cli/tick.ts",
    "backfill": "tsx src/cli/backfill.ts",
    "admin": "tsx src/cli/admin.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
